APP_NAME=Yam
APP_ENV=production
# Génère ta clé avec : php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yam
DB_USERNAME=yam
DB_PASSWORD=
# Alternative SQLite (ancien mode) : DB_CONNECTION=sqlite
# Base PostgreSQL éventuelle : DB_CONNECTION=pgsql (non supporté par o2switch)

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Pusher.com (SaaS WebSocket)
# Renseigne les credentials de ton app Pusher (dashboard.pusher.com).
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu

# Reverb (WebSocket) — conservé pour compatibilité, inutilisé avec pusher
# Valeurs pour broadcast PHP → Reverb local (même conteneur)
REVERB_APP_KEY=local
REVERB_APP_SECRET=local
REVERB_APP_ID=local
REVERB_HOST=127.0.0.1
REVERB_PORT=6001
REVERB_SCHEME=ws

# Reverb server config
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=6001

# TURN (ICE relay for production calls behind NAT / firewall)
# Valeurs par défaut : serveur TURN public openrelay (gratuit, sans inscription).
# En production, remplace par ton propre serveur TURN (ex: Metered, Twilio, Coturn).
TURN_URL=turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443?transport=tcp,turns:openrelay.metered.ca:443?transport=tcp
TURN_USERNAME=openrelay
TURN_CREDENTIAL=openrelay
TURN_PASSWORD=openrelay

# Mail (SMTP)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS (stockage S3 — optionnel)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Firebase Cloud Messaging (notifications push)
# - PUSH_ENABLED : active/désactive l'envoi des notifications push (true en prod)
# - FCM_SERVER_KEY : clé serveur (Project settings → Cloud Messaging)
# - FIREBASE_SERVICE_ACCOUNT_JSON : JSON du service account (ou base64) pour
#   la prod (secret serveur o2switch) — le fichier storage/firebase/ est gitignoré
# - VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY : Web Push certificates (VAPID)
# - VAPID_SUBJECT : email de contact pour le Web Push
PUSH_ENABLED=true
FCM_SERVER_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yam.app

# Frontend (Vite)
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY=local
VITE_REVERB_APP_HOST=127.0.0.1
VITE_REVERB_APP_PORT=6001
VITE_REVERB_APP_SCHEME=ws